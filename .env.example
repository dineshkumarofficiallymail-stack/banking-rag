# ---- App ----
APP_NAME=banking-rag
ENV=dev                      # dev | staging | prod
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]
ALLOW_REGISTRATION=true

# ---- Database (asyncpg driver) ----
DATABASE_URL=postgresql+asyncpg://rag:change-me@localhost:5432/banking_rag

# ---- Redis (optional: caching + rate limiting) ----
REDIS_URL=redis://localhost:6379/0

# ---- Auth ----
JWT_SECRET=generate-with: python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Seed admin (optional, used by scripts/init_db.py) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# ---- LLM ----
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-5
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# ---- Embeddings (fastembed = local, no API key) ----
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
FASTEMBED_CACHE_PATH=.cache/fastembed

# ---- RAG ----
TOP_K=6
MAX_CONTEXT_CHARS=12000
MIN_SIMILARITY=0.35
RATE_LIMIT_PER_MINUTE=30
AGENT_MAX_STEPS=4
MAX_UPLOAD_MB=25
CACHE_TTL_SECONDS=3600

# ---- Testing/CI: deterministic fake LLM + embeddings, no network ----
OFFLINE_MODE=false
